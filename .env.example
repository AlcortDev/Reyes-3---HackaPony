# PostgreSQL (Docker / Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lavaquita
POSTGRES_PORT=5432

# Prisma ORM Connection String
# Usa localhost:5432 si corres Next.js en tu máquina local y Postgres en Docker (`docker compose up -d postgres`)
# El contenedor `app` en docker-compose sobrescribe automáticamente el host a `postgres:5432`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavaquita?schema=public"

# Better Auth
BETTER_AUTH_SECRET="hackapony-2026-reyes-3-super-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Next.js Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
