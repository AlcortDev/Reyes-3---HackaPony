# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env  (cp .env.example .env)
# .env NUNCA se sube al repo [RNF-SEC-13]
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Docker / Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lavaquita
POSTGRES_PORT=5432

# Prisma ORM Connection String
# Usa localhost:5432 si corres Next.js en tu máquina y Postgres en Docker (`npm run db:up`)
# El contenedor `app` en docker-compose sobrescribe automáticamente el host a `postgres:5432`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavaquita?schema=public"

# Better Auth
# Genera uno propio:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Orígenes extra permitidos (IP de la laptop de demo en la red local), separados por coma
# Ej.: http://192.168.1.50:3000
TRUSTED_ORIGINS=""

# Next.js Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cifrado de documentos (INE, comprobante, fachada) con AES-256-GCM [RNF-SEC-09]
# 32 bytes en base64:  openssl rand -base64 32
DOCS_ENCRYPTION_KEY=""

# Correo: Mailpit en local (http://localhost:8025)
# Usa 127.0.0.1, no "localhost": Node lo resuelve a IPv6 (::1) y Mailpit suele escuchar en IPv4
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
MAIL_FROM="La Vaquita <no-responder@lavaquita.local>"

# Cuentas del seed (solo demo) [RF-DEM-03]
ADMIN_EMAIL="admin@lavaquita.local"
ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
